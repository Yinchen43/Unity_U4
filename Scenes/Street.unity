  - line:
      subtitle: Get out of the way bruh, you slow-ass *nice word*.
      audioClip: {fileID: 8300000, guid: 56751624dff723a45a699d77196619ec, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 0.4
    pauseAfter: 0
  - line:
      subtitle: How is he moving sideways so quickly?
      audioClip: {fileID: 8300000, guid: fe3c4ec3d3735d1449042a804ccb9596, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 0.4
    pauseAfter: 0
  - line:
      subtitle: It seems this world really wants you to be late for the game jam.
      audioClip: {fileID: 8300000, guid: 9ab00ccdcc3cc824fb024605428ab869, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 0.5
    pauseAfter: 0
  - line:
      subtitle: Now, are you going to let this individual determine your fate...
        or act against your morals and set foot on the bike lane?
      audioClip: {fileID: 8300000, guid: a13c22cad480c8a4eb4a6856710a3f95, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 0.4
    pauseAfter: 0
  bikeLaneLines:
  - line:
      subtitle: What?! How is he doing that?!
      audioClip: {fileID: 8300000, guid: 2a2633c73b1c2cb47bf040f42a32e8e8, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 0.4
    pauseAfter: 0
  - line:
      subtitle: Can we kick this slow guy?
      audioClip: {fileID: 8300000, guid: cc51ca8f73171c8489aeff2b86bdca64, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 0.5
    pauseAfter: 0
  - line:
      subtitle: You know, I usually would not recommend this, but try the road. It
        is only a quick overtake. Surely there are no cars.
      audioClip: {fileID: 8300000, guid: 03d22824d55662f4399c2b785155afcc, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 0.4
    pauseAfter: 0
  roadLaneLines:
  - line:
      subtitle: .........
      audioClip: {fileID: 0}
      charactersPerSecond: 2
      holdAfterLine: 0.5
    pauseAfter: 0
