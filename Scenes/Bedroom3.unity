MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1266731020}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9add092c04535274ca26e61613855de4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KitchenSequenceManager
  pillowObject: {fileID: 9014776604262545881}
  baguetteUnderPillow: {fileID: 2345832678838882011}
  baguetteInToaster: {fileID: 1490137173}
  fireRoot: {fileID: 253834172}
  fireAudio: {fileID: 442222540}
  delayBeforeFire: 2
  nextSceneName: Foyer
  toasterFirstLine:
    subtitle: "Ahh\u2026 there's a toaster.. But no bread? Have you checked your
      pillow?"
    audioClip: {fileID: 8300000, guid: 3eac89db0c472864482f141ca02d2bec, type: 3}
    charactersPerSecond: 35
    holdAfterLine: 1
  pillowTooEarlyLine:
    subtitle: "You\u2019ve spent enough time with this pillow, how about you leave
      it alone for now?"
    audioClip: {fileID: 8300000, guid: 514120296b969ba409d82446154db505, type: 3}
    charactersPerSecond: 35
    holdAfterLine: 1
  pillowMovedLine:
    subtitle: 
    audioClip: {fileID: 0}
    charactersPerSecond: 35
    holdAfterLine: 1
  baguettePickedUpLine:
    subtitle: 
    audioClip: {fileID: 0}
    charactersPerSecond: 35
    holdAfterLine: 1
  toasterNeedsBreadLine:
    subtitle: 
    audioClip: {fileID: 0}
    charactersPerSecond: 35
    holdAfterLine: 1
  toasterCookingLines:
  - subtitle: "By the way, I havent introduced myself\u2026 I'm the voice in your
      head\u2026 a narrator, I suppose."
    audioClip: {fileID: 8300000, guid: e0f5ad558217e914f9d6c51bc84f092e, type: 3}
    charactersPerSecond: 35
    holdAfterLine: 1
  - subtitle: "And me? I'm the voice in his head\u2026 which makes me the real narrator."
    audioClip: {fileID: 8300000, guid: f57f19f029f88544ba55b0fb8cf47247, type: 3}
    charactersPerSecond: 0
    holdAfterLine: 1
  toasterPanicLines:
  - subtitle: "Not when we're already late\u2026 just leave, quickly! The breakfast
      can wait.\r\n"
    audioClip: {fileID: 8300000, guid: d8fcd9c9a29d7274fa5cbad1c27e6c56, type: 3}
    charactersPerSecond: 0
    holdAfterLine: 1
  frontDoorLockedLine:
    subtitle: "Let\u2019s eat breakfast first before we depart."
    audioClip: {fileID: 8300000, guid: 4ea62925ec55a3d4c98040eacfefc8e5, type: 3}
    charactersPerSecond: 35
    holdAfterLine: 1
