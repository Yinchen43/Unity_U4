  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 116793674}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9548b41a718dd64fa1bc1f166df6d0e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FunnyEndingManager
  playerController: {fileID: 221587700}
  playerInteractor: {fileID: 221587703}
  crosshair: {fileID: 732278852}
  alarmClockObject: {fileID: 227544332}
  toasterObject: {fileID: 854610058}
  liftObject: {fileID: 2009007913}
  slowNPCObject: {fileID: 1099300422}
  endingLogo: {fileID: 944193321}
  endingMusic: {fileID: 2072042976}
  musicVolume: 0.18
  musicFadeInDuration: 2
  musicFadeOutDuration: 1.5
  objectAppearanceDelay: 0.3
  delayAfterFade: 2
  logoDisplayDuration: 4
  delayAfterLogo: 0.3
  openingLines:
  - line:
      subtitle: Still looking for the exit? Sigh...
      audioClip: {fileID: 8300000, guid: ae7daf18fb95b5644bc3983b29f25112, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 1
    pauseAfter: 0
  - line:
      subtitle: Maybe the real end... is the friends we made along the way.
      audioClip: {fileID: 8300000, guid: c795c0e98410a0b4c831d066a7b50ad6, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 1
    pauseAfter: 0
  alarmClockLines:
  - line:
      subtitle: Think about... the alarm clock.
      audioClip: {fileID: 8300000, guid: 4eafab74a415ba54d896a2d791664477, type: 3}
      charactersPerSecond: 10
      holdAfterLine: 1
    pauseAfter: 0
  toasterLines:
  - line:
      subtitle: The toaster.
      audioClip: {fileID: 8300000, guid: 6361fc87d8a41284eb35ce4bad878184, type: 3}
      charactersPerSecond: 10
      holdAfterLine: 1
    pauseAfter: 0
  liftLines:
  - line:
      subtitle: Maybe the lift?
      audioClip: {fileID: 8300000, guid: 244e8500b66d5a24d8986bda887b320e, type: 3}
      charactersPerSecond: 10
      holdAfterLine: 1
    pauseAfter: 0
  slowNPCLines:
  - line:
      subtitle: Or that really slow individual walking along the road.
      audioClip: {fileID: 8300000, guid: 87803173890d0bd4d969bce797509f8b, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 1
    pauseAfter: 0
  reflectionLines:
  - line:
      subtitle: They might be everyday things, or everyday people.
      audioClip: {fileID: 8300000, guid: d64de7b1a530740439d08ab3064da068, type: 3}
      charactersPerSecond: 20
      holdAfterLine: 1
    pauseAfter: 0
  - line:
      subtitle: You may see them again tomorrow.... or maybe not.
      audioClip: {fileID: 8300000, guid: 574c770e8b9972946ae6d41683d1dd8c, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 1
    pauseAfter: 0
  - line:
      subtitle: But they have undoubtedly become an everyday part of your life.
      audioClip: {fileID: 8300000, guid: 7af8c13781c9824458a90dae311841d8, type: 3}
      charactersPerSecond: 20
      holdAfterLine: 1
    pauseAfter: 0
  - line:
      subtitle: So how about you take a breather, slow down, and appreciate the things
        around you for once?
      audioClip: {fileID: 8300000, guid: b3e83ed578ea7f449b71a54283a70d2b, type: 3}
      charactersPerSecond: 35
      holdAfterLine: 1
    pauseAfter: 0
  - line:
      subtitle: Close your eyes...
      audioClip: {fileID: 8300000, guid: 9b1621b6f46ad454aadaeb927152daee, type: 3}
      charactersPerSecond: 10
      holdAfterLine: 1
    pauseAfter: 0
  blackScreenLines:
  - line:
      subtitle: and wait...
      audioClip: {fileID: 8300000, guid: 9b1a19bba174af24793fafde660ccd38, type: 3}
      charactersPerSecond: 10
      holdAfterLine: 2
    pauseAfter: 0
  logoLines:
  - line:
      subtitle: Just 5 more minutes...
      audioClip: {fileID: 8300000, guid: af1b17db2c2084d4fa8a9174c0c05b23, type: 3}
      charactersPerSecond: 5
      holdAfterLine: 2.5
    pauseAfter: 0
  menuSceneName: MainMenu
